# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Uploaded files (transient)
uploads/*
!uploads/.gitkeep

# Generated audio (transient)
audio_output/*
!audio_output/.gitkeep

# SSL certs (local dev)
*.pem

# Doc files (project documentation, not deployed)
*.doc
*.docx

# Extracted text (development artifact)
extracted_text.txt

# Workflow diagrams (documentation only)
*.png
!frontend/*.png
